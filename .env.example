DB_USERNAME=store_user
DB_PASSWORD=change_me
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS

POSTGRES_USER=store_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=store_db

FLYWAY_URL=jdbc:postgresql://postgres:5432/store_db
FLYWAY_USER=store_user
FLYWAY_PASSWORD=change_me

REDIS_HOST=redis
REDIS_PORT=6379

# Run `openssl rand -hex 32` and keep this private. Required ONLY to claim a fresh installation.
SETUP_TOKEN=
ADMIN_MAIL=admin@example.com


# Browser origins permitted to call the API through the reverse proxy.
# *.trycloudflare.com is for temporary development tunnels only.
# In production, replace that pattern with your exact storefront origin,
# e.g. https://shop.example.com (include https:// or http://).
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,https://*.trycloudflare.com

# Cloudflare R2: create an S3 API token with Object Read & Write for this bucket.
# Set PUBLIC_DOMAIN to a PUBLIC HTTPS R2 custom domain or r2.dev domain.
# Uploaded images must be publicly readable for customers to view them.
CF_ACC_ID=
CF_ACC_KEY=
CF_SEC_ID=
CF_BUCKET=
PUBLIC_DOMAIN=

# Google SMTP
APP_PASSWORD=replace_me
